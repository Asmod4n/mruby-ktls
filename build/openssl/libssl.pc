# This file should be used when building against this OpenSSL build, and should never be installed
prefix=/home/user/mruby-ktls/build/openssl
exec_prefix=${prefix}
libdir=${exec_prefix}
includedir=${prefix}/include ${prefix}/../../deps/openssl/include 

Name: OpenSSL-libssl
Description: Secure Sockets Layer and cryptography libraries
Version: 3.5.8
Requires.private: libcrypto
Libs: -L${libdir} -lssl
Cflags: -I${prefix}/include  -I${prefix}/../../deps/openssl/include 
